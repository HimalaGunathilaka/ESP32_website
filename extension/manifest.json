{
  "manifest_version": 3,
  "name": "Focus Redirector",
  "version": "1.0",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "action":{
    "default_popup":"popup.html"
  },
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.facebook.com/*",
    "*://www.twitter.com/*"
  ],
  "background": {
    "service_worker":"background.js"
  },
  "declarative_net_request": {
    "rule_resources": []
  },
  "web_accessible_resources": [
    {
      "resources": [
        "focus.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}